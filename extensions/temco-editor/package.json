{
  "name": "temco-editor",
  "displayName": "Temco Editor",
  "description": "The editor for a Markdown page: Tiptap under a private engine seam, with a ribbon, a selection menu, a block handle, a find bar, an outline rail and a read mode.",
  "publisher": "temcocontrols",
  "version": "0.0.1",
  "private": true,
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.143.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:temcoEditor.markdown",
    "onCommand:temcoEditor.open"
  ],
  "extensionDependencies": [
    "temcocontrols.temco-docs"
  ],
  "contributes": {
    "configuration": {
      "title": "Temco Editor",
      "properties": {
        "temcoEditor.fontSize": {
          "type": "number",
          "default": 12,
          "minimum": 8,
          "maximum": 32,
          "markdownDescription": "The size of the page's text, in pixels. It is the page's own size rather than a copy of `#editor.fontSize#`: a document is read at a different scale from the code beside it."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "temcoEditor.markdown",
        "displayName": "Temco Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "temcoEditor.open",
        "title": "Open in Temco Editor",
        "category": "Temco Editor",
        "icon": "$(book)"
      },
      {
        "command": "temcoEditor.openSource",
        "title": "Open as Text",
        "category": "Temco Editor",
        "icon": "$(code)"
      },
      {
        "command": "temcoEditor.preview",
        "title": "Preview the Page",
        "category": "Temco Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "temcoEditor.diff",
        "title": "Diff with HEAD",
        "category": "Temco Editor",
        "icon": "$(git-compare)"
      },
      {
        "command": "temcoEditor.pageProperties",
        "title": "Page Properties",
        "category": "Temco Editor",
        "icon": "$(settings-gear)"
      },
      {
        "command": "temcoEditor.assist",
        "title": "Draft with the AI",
        "category": "Temco Editor",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoEditor.save",
        "title": "Save the Page",
        "category": "Temco Editor",
        "icon": "$(save)"
      }
    ],
    "keybindings": [
      {
        "command": "temcoEditor.preview",
        "key": "ctrl+alt+p",
        "when": "activeCustomEditorId == 'temcoEditor.markdown' && resourceScheme == file"
      },
      {
        "command": "temcoEditor.diff",
        "key": "ctrl+alt+d",
        "when": "activeCustomEditorId == 'temcoEditor.markdown' && resourceScheme == file"
      },
      {
        "command": "temcoEditor.assist",
        "key": "ctrl+alt+a",
        "when": "activeCustomEditorId == 'temcoEditor.markdown' && resourceScheme == file"
      },
      {
        "command": "temcoEditor.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'temcoEditor.markdown' && resourceScheme == file"
      }
    ],
    "submenus": [
      {
        "id": "temcoEditor.surface",
        "label": "Temco Editor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "temcoEditor.openSource",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "temcoEditor.surface",
          "when": "resourceLangId == markdown && resourceScheme == file",
          "group": "temcoEditor@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "temcoEditor.surface",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoEditor@1"
        }
      ],
      "temcoEditor.surface": [
        {
          "command": "temcoEditor.openSource",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'",
          "group": "0_views@1"
        },
        {
          "command": "temcoEditor.preview",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'",
          "group": "0_views@2"
        },
        {
          "command": "temcoEditor.diff",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'",
          "group": "0_views@3"
        }
      ],
      "commandPalette": [
        {
          "command": "temcoEditor.open",
          "when": "false"
        },
        {
          "command": "temcoEditor.openSource",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'"
        },
        {
          "command": "temcoEditor.preview",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'"
        },
        {
          "command": "temcoEditor.diff",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'"
        },
        {
          "command": "temcoEditor.pageProperties",
          "when": "activeCustomEditorId == 'temcoEditor.markdown'"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-commands && npm run check-fluent && npm run check-types && npm run compile && npm run check-page && npm run check-task-lists && npm run check-outline && npm run check-shortcuts && npm run build-webview && npm run check-surface",
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts",
    "check-fluent": "node --experimental-strip-types scripts/check-fluent.mts",
    "check-types": "node node_modules/typescript/bin/tsc -p tsconfig.webview.json && node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "compile": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "check-page": "node --experimental-strip-types scripts/check-page.mts",
    "check-task-lists": "node --experimental-strip-types scripts/check-task-lists.mts",
    "check-outline": "node --experimental-strip-types scripts/check-outline.mts",
    "check-shortcuts": "node --experimental-strip-types scripts/check-shortcuts.mts",
    "build-webview": "node --experimental-strip-types scripts/build-webview.mts",
    "check-surface": "node --experimental-strip-types scripts/check-surface.mts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-drag-handle": "3.32.0",
    "@tiptap/extension-drag-handle-react": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lowlight": "3.3.0",
    "marked": "15.0.12",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
