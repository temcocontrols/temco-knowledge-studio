{
  "name": "temco-projects",
  "displayName": "Temco Projects",
  "description": "Temco Projects — a documentation project as a thing: its sources, its outputs, its builds, and the pages it produces.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui",
    "temcocontrols.temco-repositories"
  ],
  "activationEvents": [
    "onView:temcoProjects.projects"
  ],
  "contributes": {
    "commands": [
      {
        "command": "temcoProjects.newProject",
        "title": "Create a Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoProjects.projectsPage",
        "title": "Projects Overview",
        "category": "Temco Projects",
        "icon": "$(layout)"
      },
      {
        "command": "temcoProjects.newProjectFromRepository",
        "title": "Create a Project from a Repository",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoProjects.returnToNewProject",
        "title": "Back to the New Project Form",
        "icon": "$(arrow-left)"
      },
      {
        "command": "temcoProjects.openProject",
        "title": "Start",
        "category": "Temco Projects",
        "icon": "$(play)"
      },
      {
        "command": "temcoProjects.editProject",
        "title": "Edit",
        "category": "Temco Projects",
        "icon": "$(edit)"
      },
      {
        "command": "temcoProjects.removeProject",
        "title": "Remove",
        "category": "Temco Projects",
        "icon": "$(trash)"
      },
      {
        "command": "temcoProjects.removeAllProjects",
        "title": "Remove All Projects",
        "category": "Temco Projects",
        "icon": "$(trash)"
      },
      {
        "command": "temcoProjects.selectProject",
        "title": "Work on a Project",
        "icon": "$(pass-filled)"
      },
      {
        "command": "temcoProjects.clearProject",
        "title": "Stop Working on a Project",
        "icon": "$(circle-slash)"
      },
      {
        "command": "temcoProjects.addSource",
        "title": "Add a Source",
        "icon": "$(add)"
      },
      {
        "command": "temcoProjects.buildProject",
        "title": "Build",
        "category": "Temco Projects",
        "icon": "$(tools)"
      },
      {
        "command": "temcoProjects.showProject",
        "title": "Show the Sources",
        "category": "Temco Projects",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "temcoProjects.newProject",
          "when": "view == temcoProjects.projects",
          "group": "navigation@0"
        },
        {
          "command": "temcoProjects.projectsPage",
          "when": "view == temcoProjects.projects",
          "group": "navigation@1"
        },
        {
          "command": "temcoProjects.removeAllProjects",
          "when": "view == temcoProjects.projects",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "temcoProjects.openProject",
          "when": "view == temcoProjects.projects && viewItem =~ /^project(\\.current)?$/",
          "group": "inline@1"
        },
        {
          "command": "temcoProjects.removeProject",
          "when": "view == temcoProjects.projects && viewItem =~ /^project(\\.current)?$/",
          "group": "inline@2"
        },
        {
          "command": "temcoProjects.openProject",
          "when": "view == temcoProjects.projects && viewItem == project",
          "group": "1_project@1"
        },
        {
          "command": "temcoProjects.editProject",
          "when": "view == temcoProjects.projects && viewItem =~ /^project(\\.current)?$/",
          "group": "1_project@2"
        },
        {
          "command": "temcoDocs.projectPage",
          "when": "view == temcoProjects.projects && viewItem =~ /^project(\\.current)?$/",
          "group": "1_project@3"
        },
        {
          "command": "temcoProjects.clearProject",
          "when": "view == temcoProjects.projects && viewItem == project.current",
          "group": "2_acts@1"
        },
        {
          "command": "temcoProjects.buildProject",
          "when": "view == temcoProjects.projects && viewItem =~ /^project(\\.current)?$/",
          "group": "2_acts@2"
        },
        {
          "command": "temcoProjects.removeProject",
          "when": "view == temcoProjects.projects && viewItem =~ /^project(\\.current)?$/",
          "group": "2_acts@3"
        }
      ]
    }
  },
  "scripts": {
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts"
  }
}
