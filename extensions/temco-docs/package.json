{
  "name": "temco-docs",
  "displayName": "Temco Docs",
  "description": "Temco Docs — the documentation module of Temco Platform: keeps product documentation in step with the code, with a local AI drafting the updates.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.95.1",
    "typescript": "^5.9.3"
  },
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui",
    "temcocontrols.temco-repositories",
    "temcocontrols.temco-projects"
  ],
  "activationEvents": [
    "onView:temcoDocs.pages",
    "onView:temcoDocs.project",
    "onView:temcoDocs.queue",
    "onView:temcoDocs.draft",
    "onView:temcoDocs.outline",
    "onCustomEditor:temcoDocs.grid",
    "onView:temcoDocs.section.pipeline"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "temcoDocs.grid",
        "displayName": "Temco Grid",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "temcoDocs.page",
        "displayName": "Temco Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "temcoDraft",
          "title": "Page",
          "icon": "media/docs.svg"
        }
      ]
    },
    "views": {
      "temco": [
        {
          "id": "temcoDocs.pages",
          "name": "Pages",
          "initialSize": 3
        },
        {
          "id": "temcoDocs.queue",
          "name": "Needs You",
          "initialSize": 1,
          "visibility": "collapsed"
        },
        {
          "id": "temcoDocs.project",
          "name": "Sources",
          "initialSize": 1,
          "visibility": "collapsed"
        },
        {
          "id": "temcoDocs.section.pipeline",
          "name": "Publish",
          "initialSize": 1,
          "visibility": "collapsed"
        }
      ],
      "temcoDraft": [
        {
          "id": "temcoDocs.outline",
          "name": "Outline",
          "initialSize": 2
        },
        {
          "id": "temcoDocs.draft",
          "name": "Draft",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoDocs.projects",
        "title": "Switch Project",
        "icon": "$(folder)"
      },
      {
        "command": "temcoDocs.projectPage",
        "title": "Project Detail",
        "shortTitle": "Detail",
        "category": "Temco Docs",
        "icon": "$(info)"
      },
      {
        "command": "temcoDocs.needsPage",
        "title": "Open Needs You",
        "icon": "$(tasklist)"
      },
      {
        "command": "temcoDocs.createProjectFolder",
        "title": "Create the Project's Documentation Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoDocs.repository",
        "title": "Show the Sources",
        "icon": "$(repo)"
      },
      {
        "command": "temcoDocs.documents",
        "title": "Show the Pages",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.page",
        "title": "Open a Page",
        "icon": "$(document)"
      },
      {
        "command": "temcoDocs.pageProperties",
        "title": "Page Properties",
        "icon": "$(gear)"
      },
      {
        "command": "temcoDocs.previewPage",
        "title": "Preview the Page",
        "category": "Temco Docs",
        "icon": "$(preview)"
      },
      {
        "command": "temcoDocs.diffPage",
        "title": "Diff the Page with HEAD",
        "category": "Temco Docs",
        "icon": "$(git-compare)"
      },
      {
        "command": "temcoDocs.outline",
        "title": "Show the Page Outline",
        "category": "Temco Docs",
        "icon": "$(list-unordered)"
      },
      {
        "command": "temcoDocs.openSource",
        "title": "Open in Source Mode",
        "category": "Temco Docs",
        "icon": "$(code)"
      },
      {
        "command": "temcoDocs.openGrid",
        "title": "Open in the Grid",
        "category": "Temco Docs",
        "icon": "$(table)"
      },
      {
        "command": "temcoDocs.openReader",
        "title": "Open the Reader",
        "category": "Temco Docs",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.import",
        "title": "Import a Document Set",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoDocs.source",
        "title": "Show the Sources",
        "icon": "$(code)"
      },
      {
        "command": "temcoDocs.review",
        "title": "Review the Drafts",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.builds",
        "title": "Show Publish",
        "icon": "$(play)"
      },
      {
        "command": "temcoDocs.releases",
        "title": "Releases",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "temcoDocs.showStatus",
        "title": "Temco Docs: Show Status"
      },
      {
        "command": "temcoDocs.overview",
        "title": "Documentation Overview",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.validate",
        "title": "Validate",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoDocs.openRegistry",
        "title": "Open Registry",
        "icon": "$(json)"
      },
      {
        "command": "temcoDocs.openPage",
        "title": "Open the Page",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoDocs.reveal",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temcoDocs.openTerminal",
        "title": "Open in Integrated Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "temcoDocs.copyPath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "temcoDocs.copyRelativePath",
        "title": "Copy Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "temcoDocs.buildSite",
        "title": "Build the Site",
        "icon": "$(globe)"
      },
      {
        "command": "temcoDocs.buildHelp",
        "title": "Build the Offline Help",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.acceptDraft",
        "title": "Accept the Draft",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.revisePage",
        "title": "Draft a Change to the Page",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoDocs.discardDraft",
        "title": "Discard the Draft",
        "icon": "$(close)"
      },
      {
        "command": "temcoDocs.recordDraft",
        "title": "Record the Draft in the Review Center",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoDocs.settlePage",
        "title": "Settle Every Draft for This Page",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.openArtifact",
        "title": "Open the Artifact",
        "icon": "$(file)"
      },
      {
        "command": "temcoDocs.openFile",
        "title": "Open the File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoDocs.publishRelease",
        "title": "Publish the Release",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "temcoDocs.openPublished",
        "title": "Open the Published Site",
        "icon": "$(globe)"
      },
      {
        "command": "temcoDocs.servePublished",
        "title": "Serve the Published Site",
        "icon": "$(radio-tower)"
      },
      {
        "command": "temcoDocs.openLearn",
        "title": "Open the Temco Learn Portal",
        "category": "Temco Docs",
        "icon": "$(globe)"
      },
      {
        "command": "temcoDocs.stopServing",
        "title": "Stop Serving the Site",
        "icon": "$(debug-stop)"
      },
      {
        "command": "temcoDocs.stalenessReport",
        "title": "Documentation Owed",
        "icon": "$(report)"
      },
      {
        "command": "temcoDocs.startRegistry",
        "title": "Start a Registry",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoDocs.analyseSource",
        "title": "Analyse the Source…",
        "icon": "$(lightbulb)"
      },
      {
        "command": "temcoDocs.feedback",
        "title": "Feedback by Owner",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "temcoDocs.runScript",
        "title": "Run One of the Repository's Documentation Scripts",
        "icon": "$(run)"
      },
      {
        "command": "temcoDocs.runOwed",
        "title": "Run the Docs-Owed Check",
        "icon": "$(law)"
      },
      {
        "command": "temcoDocs.createPage",
        "title": "Create the Missing Page File",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoDocs.format.pick",
        "title": "Format"
      },
      {
        "command": "temcoDocs.format.bold",
        "title": "Bold"
      },
      {
        "command": "temcoDocs.format.italic",
        "title": "Italic"
      },
      {
        "command": "temcoDocs.format.code",
        "title": "Inline Code"
      },
      {
        "command": "temcoDocs.format.heading",
        "title": "Heading Level"
      },
      {
        "command": "temcoDocs.format.bullet",
        "title": "Bullet List"
      },
      {
        "command": "temcoDocs.format.numbered",
        "title": "Numbered List"
      },
      {
        "command": "temcoDocs.format.task",
        "title": "Task List"
      },
      {
        "command": "temcoDocs.format.quote",
        "title": "Block Quote"
      },
      {
        "command": "temcoDocs.format.codeBlock",
        "title": "Code Block"
      },
      {
        "command": "temcoDocs.format.table",
        "title": "Table"
      },
      {
        "command": "temcoDocs.format.rule",
        "title": "Horizontal Rule"
      },
      {
        "command": "temcoDocs.format.callout",
        "title": "Callout"
      },
      {
        "command": "temcoDocs.format.link",
        "title": "Link"
      },
      {
        "command": "temcoDocs.format.linkPage",
        "title": "Link to a Page"
      },
      {
        "command": "temcoDocs.format.outline",
        "title": "Go to a Heading"
      },
      {
        "command": "temcoDocs.newPage",
        "title": "New Page",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoDocs.newChapter",
        "title": "New Folder…",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoDocs.rename",
        "title": "Rename…",
        "icon": "$(edit)"
      },
      {
        "command": "temcoDocs.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "temcoDocs.cut",
        "title": "Cut"
      },
      {
        "command": "temcoDocs.copy",
        "title": "Copy"
      },
      {
        "command": "temcoDocs.paste",
        "title": "Paste"
      },
      {
        "command": "temcoDocs.newPage.article",
        "title": "New Article Page"
      },
      {
        "command": "temcoDocs.newPage.task",
        "title": "New Task Page"
      },
      {
        "command": "temcoDocs.newPage.reference",
        "title": "New Reference Page"
      },
      {
        "command": "temcoDocs.newPage.troubleshooting",
        "title": "New Troubleshooting Page"
      },
      {
        "command": "temcoDocs.newPage.releaseNote",
        "title": "New Release Note Page"
      },
      {
        "command": "temcoDocs.renamePage",
        "title": "Rename the Page Title",
        "icon": "$(edit)"
      },
      {
        "command": "temcoDocs.movePageUp",
        "title": "Move the Page Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "temcoDocs.movePageDown",
        "title": "Move the Page Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "temcoDocs.retirePage",
        "title": "Retire the Page",
        "icon": "$(archive)"
      },
      {
        "command": "temcoDocs.pasteImage",
        "title": "Paste Screenshot",
        "icon": "$(clippy)"
      },
      {
        "command": "temcoDocs.captureImage",
        "title": "Capture a Screenshot",
        "icon": "$(device-camera)"
      },
      {
        "command": "temcoDocs.chooseImage",
        "title": "Insert an Image File…",
        "icon": "$(file-media)"
      },
      {
        "command": "temcoDocs.staleScreenshots",
        "title": "Stale Screenshots"
      },
      {
        "command": "temcoDocs.attachCapture",
        "title": "Attach the Screenshot to a Page…",
        "icon": "$(link)"
      },
      {
        "command": "temcoDocs.importDocx",
        "title": "Import a Word Document",
        "category": "Temco Docs",
        "icon": "$(file-add)"
      },
      {
        "command": "temcoDocs.page.open",
        "title": "Open in Temco Editor",
        "category": "Temco Docs",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "temcoDocs.previewPage",
        "key": "ctrl+alt+p",
        "when": "(editorLangId == markdown || activeCustomEditorId == 'temcoDocs.page') && resourceScheme == file"
      },
      {
        "command": "temcoDocs.diffPage",
        "key": "ctrl+alt+d",
        "when": "(editorLangId == markdown || activeCustomEditorId == 'temcoDocs.page') && resourceScheme == file"
      },
      {
        "command": "temcoDocs.captureImage",
        "key": "ctrl+alt+s",
        "when": "editorLangId == markdown || activeCustomEditorId == 'temcoDocs.page'"
      },
      {
        "command": "temcoDocs.pasteImage",
        "key": "ctrl+alt+v",
        "when": "editorLangId == markdown || activeCustomEditorId == 'temcoDocs.page'"
      },
      {
        "command": "temcoDocs.rename",
        "key": "f2",
        "when": "focusedView == temcoDocs.pages"
      },
      {
        "command": "temcoDocs.renamePage",
        "key": "shift+f2",
        "when": "focusedView == temcoDocs.pages"
      },
      {
        "command": "temcoDocs.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == temcoDocs.pages && listFocus && !inputFocus"
      },
      {
        "command": "temcoDocs.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == temcoDocs.pages && listFocus && !inputFocus"
      },
      {
        "command": "temcoDocs.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == temcoDocs.pages && listFocus && !inputFocus"
      },
      {
        "command": "temcoDocs.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == temcoDocs.pages && listFocus && !inputFocus && temcoDocs.hasClipboard"
      }
    ],
    "submenus": [
      {
        "id": "temcoDocs.markdown",
        "label": "Temco Docs"
      },
      {
        "id": "temcoDocs.pageKinds",
        "label": "New Page of a Kind"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "temcoDocs.format.bold",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@1"
        },
        {
          "command": "temcoDocs.format.italic",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@2"
        },
        {
          "command": "temcoDocs.format.linkPage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@3"
        },
        {
          "command": "temcoDocs.format.pick",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@4"
        },
        {
          "command": "temcoDocs.pageProperties",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@5"
        },
        {
          "command": "temcoDocs.previewPage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@6"
        },
        {
          "command": "temcoDocs.diffPage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@6"
        },
        {
          "command": "temcoDocs.captureImage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@7"
        },
        {
          "command": "temcoDocs.pasteImage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@7"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "temcoDocs.surface",
          "when": "resourceLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "temcoDocs.surface",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@1"
        }
      ],
      "temcoDocs.surface": [
        {
          "command": "temcoDocs.openSource",
          "when": "activeCustomEditorId == 'temcoDocs.page'",
          "group": "0_views@1"
        },
        {
          "command": "temcoDocs.previewPage",
          "when": "activeCustomEditorId == 'temcoDocs.page'",
          "group": "0_views@2"
        },
        {
          "command": "temcoDocs.diffPage",
          "when": "activeCustomEditorId == 'temcoDocs.page'",
          "group": "0_views@3"
        },
        {
          "command": "temcoDocs.format.pick",
          "group": "0_top@1"
        },
        {
          "command": "temcoDocs.format.bold",
          "group": "1_inline@1"
        },
        {
          "command": "temcoDocs.format.italic",
          "group": "1_inline@2"
        },
        {
          "command": "temcoDocs.format.code",
          "group": "1_inline@3"
        },
        {
          "command": "temcoDocs.format.heading",
          "group": "2_blocks@1"
        },
        {
          "command": "temcoDocs.format.bullet",
          "group": "2_blocks@2"
        },
        {
          "command": "temcoDocs.format.numbered",
          "group": "2_blocks@3"
        },
        {
          "command": "temcoDocs.format.task",
          "group": "2_blocks@4"
        },
        {
          "command": "temcoDocs.format.quote",
          "group": "2_blocks@5"
        },
        {
          "command": "temcoDocs.format.codeBlock",
          "group": "2_blocks@6"
        },
        {
          "command": "temcoDocs.format.table",
          "group": "2_blocks@7"
        },
        {
          "command": "temcoDocs.format.rule",
          "group": "2_blocks@8"
        },
        {
          "command": "temcoDocs.format.callout",
          "group": "2_blocks@9"
        },
        {
          "command": "temcoDocs.format.link",
          "group": "3_insert@1"
        },
        {
          "command": "temcoDocs.format.linkPage",
          "group": "3_insert@2"
        },
        {
          "command": "temcoDocs.captureImage",
          "group": "3_insert@3"
        },
        {
          "command": "temcoDocs.pasteImage",
          "group": "3_insert@4"
        },
        {
          "command": "temcoDocs.chooseImage",
          "group": "3_insert@5"
        },
        {
          "command": "temcoDocs.format.outline",
          "group": "4_navigate@1"
        },
        {
          "command": "temcoDocs.page.open",
          "group": "5_surface@1"
        }
      ],
      "temcoDocs.pageKinds": [
        {
          "command": "temcoDocs.newPage.article",
          "group": "1_kind@1"
        },
        {
          "command": "temcoDocs.newPage.task",
          "group": "1_kind@2"
        },
        {
          "command": "temcoDocs.newPage.reference",
          "group": "1_kind@3"
        },
        {
          "command": "temcoDocs.newPage.troubleshooting",
          "group": "1_kind@4"
        },
        {
          "command": "temcoDocs.newPage.releaseNote",
          "group": "1_kind@5"
        }
      ],
      "view/title": [
        {
          "command": "temcoDocs.newPage",
          "when": "view == temcoDocs.pages",
          "group": "navigation@0"
        },
        {
          "command": "temcoDocs.newChapter",
          "when": "view == temcoDocs.pages",
          "group": "navigation@1"
        },
        {
          "command": "temcoProjects.addSource",
          "when": "view == temcoDocs.pages",
          "group": "navigation@2"
        },
        {
          "command": "temcoDocs.captureImage",
          "when": "view == temcoDocs.pages",
          "group": "navigation@3"
        },
        {
          "command": "temcoDocs.pasteImage",
          "when": "view == temcoDocs.pages",
          "group": "navigation@4"
        },
        {
          "command": "temcoDocs.refresh",
          "when": "view == temcoDocs.pages",
          "group": "navigation@5"
        },
        {
          "command": "temcoDocs.refresh",
          "when": "view == temcoDocs.queue",
          "group": "navigation@0"
        },
        {
          "command": "temcoDocs.openPage",
          "when": "view == temcoDocs.pages",
          "group": "1_open@1"
        },
        {
          "submenu": "temcoDocs.pageKinds",
          "when": "view == temcoDocs.pages",
          "group": "2_kind@1"
        },
        {
          "command": "temcoDocs.createPage",
          "when": "view == temcoDocs.pages",
          "group": "2_missing@1"
        },
