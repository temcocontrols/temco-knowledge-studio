{
  "name": "temco-docs",
  "displayName": "Temco Docs",
  "description": "Temco Docs — the documentation module of Temco Platform: keeps product documentation in step with the code, with a local AI drafting the updates.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui",
    "temcocontrols.temco-repositories",
    "temcocontrols.temco-projects"
  ],
  "activationEvents": [
    "onView:temcoDocs.pages",
    "onView:temcoDocs.project",
    "onView:temcoDocs.queue",
    "onView:temcoDocs.draft",
    "onView:temcoDocs.section.pipeline",
    "onView:temcoDocs.section.working"
  ],
  "contributes": {
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "temcoDraft",
          "title": "Draft",
          "icon": "media/docs.svg"
        }
      ]
    },
    "views": {
      "temco": [
        {
          "id": "temcoDocs.pages",
          "name": "Pages"
        },
        {
          "id": "temcoDocs.project",
          "name": "Project"
        },
        {
          "id": "temcoDocs.section.pipeline",
          "name": "Pipeline"
        },
        {
          "id": "temcoDocs.section.working",
          "name": "Working Set"
        }
      ],
      "temcoDraft": [
        {
          "id": "temcoDocs.draft",
          "name": "Draft",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoDocs.projects",
        "title": "Projects",
        "icon": "$(folder)"
      },
      {
        "command": "temcoDocs.projectPage",
        "title": "Open the Project Page",
        "icon": "$(folders)"
      },
      {
        "command": "temcoDocs.needsPage",
        "title": "Open Needs You",
        "icon": "$(tasklist)"
      },
      {
        "command": "temcoDocs.repository",
        "title": "Open a Repository",
        "icon": "$(repo)"
      },
      {
        "command": "temcoDocs.documents",
        "title": "Documents",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.page",
        "title": "Open a Page",
        "icon": "$(document)"
      },
      {
        "command": "temcoDocs.pageProperties",
        "title": "Page Properties",
        "icon": "$(gear)"
      },
      {
        "command": "temcoDocs.import",
        "title": "Import a Document Set",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoDocs.source",
        "title": "Open a Source",
        "icon": "$(code)"
      },
      {
        "command": "temcoDocs.review",
        "title": "Review Center",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.builds",
        "title": "Build Center",
        "icon": "$(play)"
      },
      {
        "command": "temcoDocs.releases",
        "title": "Releases",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "temcoDocs.showStatus",
        "title": "Temco Docs: Show Status"
      },
      {
        "command": "temcoDocs.overview",
        "title": "Documentation Overview",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.validate",
        "title": "Validate",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoDocs.openRegistry",
        "title": "Open Registry",
        "icon": "$(json)"
      },
      {
        "command": "temcoDocs.openPage",
        "title": "Open the Page",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoDocs.reveal",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "temcoDocs.openTerminal",
        "title": "Open in Integrated Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "temcoDocs.copyPath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "temcoDocs.copyRelativePath",
        "title": "Copy Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "temcoDocs.buildSite",
        "title": "Build the Site",
        "icon": "$(globe)"
      },
      {
        "command": "temcoDocs.buildHelp",
        "title": "Build the Offline Help",
        "icon": "$(book)"
      },
      {
        "command": "temcoDocs.acceptDraft",
        "title": "Accept the Draft",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.revisePage",
        "title": "Draft a Change to the Page",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoDocs.discardDraft",
        "title": "Discard the Draft",
        "icon": "$(close)"
      },
      {
        "command": "temcoDocs.recordDraft",
        "title": "Record the Draft in the Review Center",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoDocs.settlePage",
        "title": "Settle Every Draft for This Page",
        "icon": "$(check)"
      },
      {
        "command": "temcoDocs.openArtifact",
        "title": "Open the Artifact",
        "icon": "$(file)"
      },
      {
        "command": "temcoDocs.openFile",
        "title": "Open the File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "temcoDocs.publishRelease",
        "title": "Publish the Release",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "temcoDocs.openPublished",
        "title": "Open the Published Site",
        "icon": "$(globe)"
      },
      {
        "command": "temcoDocs.servePublished",
        "title": "Serve the Published Site",
        "icon": "$(radio-tower)"
      },
      {
        "command": "temcoDocs.stopServing",
        "title": "Stop Serving the Site",
        "icon": "$(debug-stop)"
      },
      {
        "command": "temcoDocs.stalenessReport",
        "title": "Documentation Owed",
        "icon": "$(report)"
      },
      {
        "command": "temcoDocs.startRegistry",
        "title": "Start a Registry",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoDocs.analyseSource",
        "title": "Analyse the Source…",
        "icon": "$(lightbulb)"
      },
      {
        "command": "temcoDocs.feedback",
        "title": "Feedback by Owner",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "temcoDocs.runScript",
        "title": "Run One of the Repository's Documentation Scripts",
        "icon": "$(run)"
      },
      {
        "command": "temcoDocs.runOwed",
        "title": "Run the Docs-Owed Check",
        "icon": "$(law)"
      },
      {
        "command": "temcoDocs.createPage",
        "title": "Create the Missing Page File",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoDocs.format.pick",
        "title": "Format"
      },
      {
        "command": "temcoDocs.format.bold",
        "title": "Bold"
      },
      {
        "command": "temcoDocs.format.italic",
        "title": "Italic"
      },
      {
        "command": "temcoDocs.format.code",
        "title": "Inline Code"
      },
      {
        "command": "temcoDocs.format.heading",
        "title": "Heading Level"
      },
      {
        "command": "temcoDocs.format.bullet",
        "title": "Bullet List"
      },
      {
        "command": "temcoDocs.format.numbered",
        "title": "Numbered List"
      },
      {
        "command": "temcoDocs.format.task",
        "title": "Task List"
      },
      {
        "command": "temcoDocs.format.quote",
        "title": "Block Quote"
      },
      {
        "command": "temcoDocs.format.codeBlock",
        "title": "Code Block"
      },
      {
        "command": "temcoDocs.format.table",
        "title": "Table"
      },
      {
        "command": "temcoDocs.format.rule",
        "title": "Horizontal Rule"
      },
      {
        "command": "temcoDocs.format.callout",
        "title": "Callout"
      },
      {
        "command": "temcoDocs.format.link",
        "title": "Link"
      },
      {
        "command": "temcoDocs.format.linkPage",
        "title": "Link to a Page"
      },
      {
        "command": "temcoDocs.format.outline",
        "title": "Go to a Heading"
      },
      {
        "command": "temcoDocs.newPage",
        "title": "New Page",
        "icon": "$(new-file)"
      },
      {
        "command": "temcoDocs.newChapter",
        "title": "New Chapter",
        "icon": "$(new-folder)"
      },
      {
        "command": "temcoDocs.newPage.article",
        "title": "New Article Page"
      },
      {
        "command": "temcoDocs.newPage.task",
        "title": "New Task Page"
      },
      {
        "command": "temcoDocs.newPage.reference",
        "title": "New Reference Page"
      },
      {
        "command": "temcoDocs.newPage.troubleshooting",
        "title": "New Troubleshooting Page"
      },
      {
        "command": "temcoDocs.newPage.releaseNote",
        "title": "New Release Note Page"
      },
      {
        "command": "temcoDocs.renamePage",
        "title": "Rename the Page Title",
        "icon": "$(edit)"
      },
      {
        "command": "temcoDocs.renameFile",
        "title": "Rename the File…",
        "icon": "$(file)"
      },
      {
        "command": "temcoDocs.movePageUp",
        "title": "Move the Page Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "temcoDocs.movePageDown",
        "title": "Move the Page Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "temcoDocs.retirePage",
        "title": "Retire the Page",
        "icon": "$(archive)"
      },
      {
        "command": "temcoDocs.pasteImage",
        "title": "Paste Screenshot",
        "icon": "$(clippy)"
      },
      {
        "command": "temcoDocs.captureImage",
        "title": "Capture a Screenshot",
        "icon": "$(device-camera)"
      },
      {
        "command": "temcoDocs.chooseImage",
        "title": "Insert an Image File…",
        "icon": "$(file-media)"
      },
      {
        "command": "temcoDocs.attachCapture",
        "title": "Attach the Screenshot to a Page…",
        "icon": "$(link)"
      }
    ],
    "keybindings": [
      {
        "command": "temcoDocs.captureImage",
        "key": "ctrl+alt+s",
        "when": "editorLangId == markdown"
      },
      {
        "command": "temcoDocs.pasteImage",
        "key": "ctrl+alt+v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "temcoDocs.renameFile",
        "key": "f2",
        "when": "focusedView == temcoDocs.pages"
      },
      {
        "command": "temcoDocs.renamePage",
        "key": "shift+f2",
        "when": "focusedView == temcoDocs.pages"
      }
    ],
    "submenus": [
      {
        "id": "temcoDocs.markdown",
        "label": "Temco Docs"
      },
      {
        "id": "temcoDocs.pageKinds",
        "label": "New Page of a Kind"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "temcoDocs.format.bold",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@1"
        },
        {
          "command": "temcoDocs.format.italic",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@2"
        },
        {
          "command": "temcoDocs.format.linkPage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@3"
        },
        {
          "command": "temcoDocs.format.pick",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@4"
        },
        {
          "command": "temcoDocs.pageProperties",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@5"
        },
        {
          "command": "temcoDocs.captureImage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@6"
        },
        {
          "command": "temcoDocs.pasteImage",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@7"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "temcoDocs.markdown",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "temcoDocs.markdown",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "temcoDocs@1"
        }
      ],
      "temcoDocs.markdown": [
        {
          "command": "temcoDocs.format.pick",
          "group": "0_top@1"
        },
        {
          "command": "temcoDocs.format.bold",
          "group": "1_inline@1"
        },
        {
          "command": "temcoDocs.format.italic",
          "group": "1_inline@2"
        },
        {
          "command": "temcoDocs.format.code",
          "group": "1_inline@3"
        },
        {
          "command": "temcoDocs.format.heading",
          "group": "2_blocks@1"
        },
        {
          "command": "temcoDocs.format.bullet",
          "group": "2_blocks@2"
        },
        {
          "command": "temcoDocs.format.numbered",
          "group": "2_blocks@3"
        },
        {
          "command": "temcoDocs.format.task",
          "group": "2_blocks@4"
        },
        {
          "command": "temcoDocs.format.quote",
          "group": "2_blocks@5"
        },
        {
          "command": "temcoDocs.format.codeBlock",
          "group": "2_blocks@6"
        },
        {
          "command": "temcoDocs.format.table",
          "group": "2_blocks@7"
        },
        {
          "command": "temcoDocs.format.rule",
          "group": "2_blocks@8"
        },
        {
          "command": "temcoDocs.format.callout",
          "group": "2_blocks@9"
        },
        {
          "command": "temcoDocs.format.link",
          "group": "3_insert@1"
        },
        {
          "command": "temcoDocs.format.linkPage",
          "group": "3_insert@2"
        },
        {
          "command": "temcoDocs.captureImage",
          "group": "3_insert@3"
        },
        {
          "command": "temcoDocs.pasteImage",
          "group": "3_insert@4"
        },
        {
          "command": "temcoDocs.chooseImage",
          "group": "3_insert@5"
        },
        {
          "command": "temcoDocs.format.outline",
          "group": "4_navigate@1"
        }
      ],
      "temcoDocs.pageKinds": [
        {
          "command": "temcoDocs.newPage.article",
          "group": "1_kind@1"
        },
        {
          "command": "temcoDocs.newPage.task",
          "group": "1_kind@2"
        },
        {
          "command": "temcoDocs.newPage.reference",
          "group": "1_kind@3"
        },
        {
          "command": "temcoDocs.newPage.troubleshooting",
          "group": "1_kind@4"
        },
        {
          "command": "temcoDocs.newPage.releaseNote",
          "group": "1_kind@5"
        }
      ],
      "view/title": [
        {
          "command": "temcoDocs.newPage",
          "when": "view == temcoDocs.pages",
          "group": "navigation@0"
        },
        {
          "command": "temcoDocs.newChapter",
          "when": "view == temcoDocs.pages",
          "group": "navigation@1"
        },
        {
          "command": "temcoProjects.addSource",
          "when": "view == temcoDocs.pages",
          "group": "navigation@2"
        },
        {
          "command": "temcoDocs.captureImage",
          "when": "view == temcoDocs.pages",
          "group": "navigation@3"
        },
        {
          "command": "temcoDocs.pasteImage",
          "when": "view == temcoDocs.pages",
          "group": "navigation@4"
        },
        {
          "command": "temcoDocs.refresh",
          "when": "view == temcoDocs.pages",
          "group": "navigation@5"
        },
        {
          "command": "temcoDocs.refresh",
          "when": "view == temcoDocs.queue",
          "group": "navigation@0"
        },
        {
          "command": "temcoDocs.openPage",
          "when": "view == temcoDocs.pages",
          "group": "1_open@1"
        },
        {
          "submenu": "temcoDocs.pageKinds",
          "when": "view == temcoDocs.pages",
          "group": "2_kind@1"
        },
        {
          "command": "temcoDocs.createPage",
          "when": "view == temcoDocs.pages",
          "group": "2_missing@1"
        },
        {
          "command": "temcoDocs.reveal",
          "when": "view == temcoDocs.pages",
          "group": "2_show@1"
        },
        {
          "command": "temcoDocs.openTerminal",
          "when": "view == temcoDocs.pages",
          "group": "2_show@2"
        },
        {
          "command": "temcoDocs.copyPath",
          "when": "view == temcoDocs.pages",
          "group": "2_show@3"
        },
        {
          "command": "temcoDocs.copyRelativePath",
          "when": "view == temcoDocs.pages",
          "group": "2_show@4"
        },
        {
          "command": "temcoDocs.renamePage",
          "when": "view == temcoDocs.pages",
          "group": "3_edit@1"
        },
        {
          "command": "temcoDocs.movePageUp",
          "when": "view == temcoDocs.pages",
          "group": "3_edit@2"
        },
        {
          "command": "temcoDocs.movePageDown",
          "when": "view == temcoDocs.pages",
          "group": "3_edit@3"
        },
        {
          "command": "temcoDocs.retirePage",
          "when": "view == temcoDocs.pages",
          "group": "4_retire@1"
        },
        {
          "command": "temcoDocs.overview",
          "when": "view == temcoDocs.pages",
          "group": "5_view@1"
        },
        {
          "command": "temcoWorkbench.home",
          "when": "view == temcoDocs.pages",
          "group": "5_view@1"
        },
        {
          "command": "temcoDocs.validate",
          "when": "view == temcoDocs.pages",
          "group": "5_view@2"
        },
        {
          "command": "temcoDocs.openRegistry",
          "when": "view == temcoDocs.pages",
          "group": "9_registry@1"
        }
      ],
      "view/item/context": [
        {
          "command": "temcoDocs.attachCapture",
          "when": "view == temcoDocs.queue && viewItem == capture",
          "group": "1_attach@1"
        },
        {
          "command": "temcoDocs.createPage",
          "when": "view == temcoDocs.pages && viewItem == missingPage",
          "group": "0_missing@1"
        },
        {
          "command": "temcoDocs.newPage",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter)$/",
          "group": "1_new@1"
        },
        {
          "command": "temcoDocs.newChapter",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter)$/",
          "group": "1_new@2"
        },
        {
          "submenu": "temcoDocs.pageKinds",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter)$/",
          "group": "1_new@3"
        },
        {
          "command": "temcoDocs.openPage",
          "when": "view == temcoDocs.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "1_open@1"
        },
        {
          "command": "temcoDocs.reveal",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter|page|missingPage)$/",
          "group": "2_show@1"
        },
        {
          "command": "temcoDocs.openTerminal",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter|page|missingPage)$/",
          "group": "2_show@2"
        },
        {
          "command": "temcoDocs.copyPath",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter|page|missingPage)$/",
          "group": "2_show@3"
        },
        {
          "command": "temcoDocs.copyRelativePath",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter|page|missingPage)$/",
          "group": "2_show@4"
        },
        {
          "command": "temcoDocs.renameFile",
          "when": "view == temcoDocs.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@0"
        },
        {
          "command": "temcoDocs.renamePage",
          "when": "view == temcoDocs.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@1"
        },
        {
          "command": "temcoDocs.movePageUp",
          "when": "view == temcoDocs.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@2"
        },
        {
          "command": "temcoDocs.movePageDown",
          "when": "view == temcoDocs.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "3_edit@3"
        },
        {
          "command": "temcoDocs.retirePage",
          "when": "view == temcoDocs.pages && viewItem =~ /^(page|missingPage)$/",
          "group": "4_retire@1"
        },
        {
          "command": "temcoDocs.openRegistry",
          "when": "view == temcoDocs.pages && viewItem =~ /^(folder|area|chapter|page|missingPage)$/",
          "group": "9_registry@1"
        }
      ]
    },
    "viewsWelcome": [],
    "configuration": []
  },
  "scripts": {
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts"
  }
}
