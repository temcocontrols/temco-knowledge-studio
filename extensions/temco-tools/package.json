    "onView:temcoTools.ioLive",
    "onView:temcoTools.bacnetNetwork",
    "onView:temcoTools.bacnetHistory",
    "onView:temcoTools.networkTools",
    "onView:temcoTools.networkTraffic",
    "onView:temcoTools.sqlWorkbench",
    "onView:temcoTools.sqlDocs"
