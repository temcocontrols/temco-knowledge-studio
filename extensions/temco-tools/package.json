  "contributes": {
    "views": {
      "temcoDevices": [
        {
          "id": "temcoTools.devicesFleet",
          "name": "Fleet"
        },
        {
          "id": "temcoTools.devicesData",
          "name": "Data"
        }
      ],
      "temcoIo": [
        {
          "id": "temcoTools.ioEngineering",
          "name": "Engineering"
        },
        {
          "id": "temcoTools.ioLive",
          "name": "Live"
        }
