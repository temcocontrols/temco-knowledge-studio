{
  "name": "temco-workbench",
  "displayName": "Temco Workbench",
  "description": "Temco Workbench — the application's own surfaces: the Library that lists what every module has, the dashboard, and what needs doing.",
  "version": "0.0.1",
  "publisher": "temcocontrols",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/temcocontrols/temco-platform.git"
  },
  "bugs": {
    "url": "https://github.com/temcocontrols/temco-platform/issues"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "type": "commonjs",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "temcocontrols.temco-store",
    "temcocontrols.temco-ui",
    "temcocontrols.temco-repositories",
    "temcocontrols.temco-docs"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:temcoWorkbench.learnView",
    "onView:temcoWorkbench.learnDelivery",
    "onView:temcoWorkbench.settingsProfile",
    "onView:temcoWorkbench.settingsPlatform",
    "onView:temcoWorkbench.helpLearn",
    "onView:temcoWorkbench.helpSupport",
    "onView:temcoWorkbench.platformView",
    "onView:temcoWorkbench.activityView"
  ],
  "contributes": {
    "views": {
      "temcoDashboard": [
        {
          "id": "temcoProjects.projects",
          "name": "Projects"
        },
        {
          "id": "temcoWorkbench.platformView",
          "name": "Overview"
        },
        {
          "id": "temcoWorkbench.activityView",
          "name": "Recent activity"
        },
        {
          "id": "temcoWorkbench.learnView",
          "name": "Site"
        },
        {
          "id": "temcoWorkbench.learnDelivery",
          "name": "Delivery"
        }
      ],
      "temcoSettings": [
        {
          "id": "temcoWorkbench.settingsProfile",
          "name": "Profile"
        },
        {
          "id": "temcoWorkbench.settingsPlatform",
          "name": "Platform"
        },
        {
          "id": "temcoWorkbench.helpLearn",
          "name": "Learn"
        },
        {
          "id": "temcoWorkbench.helpSupport",
          "name": "Support"
        }
      ]
    },
    "commands": [
      {
        "command": "temcoWorkbench.learn.home",
        "title": "Temco Learn",
        "icon": "$(home)"
      },
      {
        "command": "temcoWorkbench.learn.t3000",
        "title": "T3000",
        "icon": "$(book)"
      },
      {
        "command": "temcoWorkbench.learn.article",
        "title": "Article Preview",
        "icon": "$(document)"
      },
      {
        "command": "temcoWorkbench.learn.downloads",
        "title": "Downloads",
        "icon": "$(cloud-download)"
      },
      {
        "command": "temcoWorkbench.learn.paths",
        "title": "Learning Paths",
        "icon": "$(mortar-board)"
      },
      {
        "command": "temcoWorkbench.home",
        "title": "Home",
        "icon": "$(home)"
      },
      {
        "command": "temcoWorkbench.openNeeds",
        "title": "What Needs Doing",
        "icon": "$(checklist)"
      },
      {
        "command": "temcoWorkbench.welcome",
        "title": "Welcome",
        "icon": "$(dashboard)"
      },
      {
        "command": "temcoWorkbench.toggleWelcomeStartup",
        "title": "Open the Welcome Page at Startup"
      },
      {
        "command": "temcoWorkbench.settings",
        "title": "Settings",
        "icon": "$(gear)"
      },
      {
        "command": "temcoWorkbench.settings.general",
        "title": "General",
        "icon": "$(gear)"
      },
      {
        "command": "temcoWorkbench.settings.modules",
        "title": "Modules",
        "icon": "$(package)"
      },
      {
        "command": "temcoWorkbench.settings.branding",
        "title": "Branding",
        "icon": "$(paintcan)"
      },
      {
        "command": "temcoWorkbench.settings.ai",
        "title": "AI Models",
        "icon": "$(sparkle)"
      },
      {
        "command": "temcoWorkbench.settings.publishing",
        "title": "Publishing",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "temcoWorkbench.settings.reset",
        "title": "Restore the General Settings to Their Defaults"
      },
      {
        "command": "temcoWorkbench.settings.showOnDisk",
        "title": "Show the Modules on Disk",
        "icon": "$(folder)"
      },
      {
        "command": "temcoWorkbench.settings.checkUpdates",
        "title": "Check the Platform for Updates",
        "icon": "$(refresh)"
      },
      {
        "command": "temcoWorkbench.settings.themeDark",
        "title": "Use the Dark Theme"
      },
      {
        "command": "temcoWorkbench.settings.themeLight",
        "title": "Use the Light Theme"
      },
      {
        "command": "temcoWorkbench.settings.replaceIcon",
        "title": "Replace the Application Mark"
      },
      {
        "command": "temcoWorkbench.settings.resetBranding",
        "title": "Reset the Identity"
      },
      {
        "command": "temcoWorkbench.settings.testPublish",
        "title": "Test the Publish Target"
      },
      {
        "command": "temcoWorkbench.copyLogPath",
        "title": "Copy Log Folder Path"
      },
      {
        "command": "temcoWorkbench.copyDiagnostics",
        "title": "Copy Diagnostics"
      },
      {
        "command": "temcoWorkbench.setStartOpen",
        "title": "Set What Opens at Startup"
      },
      {
        "command": "temcoWorkbench.help",
        "title": "Help",
        "icon": "$(question)"
      },
      {
        "command": "temcoWorkbench.help.welcome",
        "title": "Welcome",
        "icon": "$(dashboard)"
      },
      {
        "command": "temcoWorkbench.help.home",
        "title": "Help",
        "icon": "$(info)"
      },
      {
        "command": "temcoWorkbench.help.keys",
        "title": "Keyboard Shortcuts",
        "icon": "$(keyboard)"
      },
      {
        "command": "temcoWorkbench.help.logs",
        "title": "Logs",
        "icon": "$(output)"
      },
      {
        "command": "temcoWorkbench.help.issue",
        "title": "Report an Issue",
        "icon": "$(report)"
      },
      {
        "command": "temcoWorkbench.help.about",
        "title": "About Temco Platform",
        "icon": "$(info)"
      },
      {
        "command": "temcoWorkbench.help.openLog",
        "title": "Open a Log File"
      },
      {
        "command": "temcoWorkbench.help.copyReport",
        "title": "Copy the Report and Open the Issue Reporter"
      },
      {
        "command": "temcoWorkbench.overview",
        "title": "Overview",
        "icon": "$(home)"
      },
      {
        "command": "temcoWorkbench.activity",
        "title": "Recent Activity",
        "icon": "$(history)"
      }
    ],
    "configuration": {
      "title": "Temco Workbench",
      "properties": {
        "temcoWorkbench.start.open": {
          "type": "string",
          "enum": [
            "welcome",
            "project",
            "page",
            "home",
            "none"
          ],
          "enumDescriptions": [
            "The welcome page — what the application is for, and the six things to do first. This is the default, and its footer checkbox writes this same setting.",
            "The project being worked on: its pages. With no project, the page you were last on.",
            "The page you were last working on in the project being worked on. With none, that project's pages.",
            "The platform's overview — what it holds and what needs a person. Reached from the Dashboard too.",
            "Nothing — no tab opens by itself."
          ],
          "default": "welcome",
          "markdownDescription": "What opens in the editor when the extension is activated — the one decision that makes a first tab. Each choice falls through to the next when it cannot be honoured: `project`, then the page you were last on, then the overview. With the welcome page switched off, that chain never ends at the welcome page. Only `none` opens nothing."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "temcoDashboard",
          "title": "Home",
          "icon": "media/dashboard.svg"
        },
        {
          "id": "temco",
          "title": "Docs",
          "icon": "media/document.svg"
        },
        {
          "id": "temcoAiHub",
          "title": "AI",
          "icon": "media/ai.svg"
        },
        {
          "id": "temcoSql",
          "title": "Tools",
          "icon": "media/sql.svg"
        },
        {
          "id": "temcoSettings",
          "title": "Settings",
          "icon": "media/settings.svg"
        }
      ]
    }
  },
  "scripts": {
    "check-commands": "node --experimental-strip-types scripts/check-commands.mts"
  }
}
